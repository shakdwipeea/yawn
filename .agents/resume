#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"

for command in node npm cargo rustfmt wasm-pack rsw weston weston-screenshooter xvfb-run identify file; do
    if ! command -v "$command" >/dev/null 2>&1; then
        echo "Missing required command after orb resume: $command" >&2
        exit 1
    fi
done

if ! pkg-config --exists wayland-client xkbcommon; then
    echo "Missing native Wayland development libraries after orb resume" >&2
    exit 1
fi

echo "Ensuring orb development services are running..."
amp orb services ensure

echo "Orb environment ready."
